# =============================================================================
#  Caddyfile 骨架 —— 這個檔是 caddy-outposts 提供的，不要編輯。
#
#  它只做兩件事：定義產品的固定邏輯（下面那些 snippet），然後把產生出來的
#  設定片段 import 進來。所有跟這台機器有關的東西都在 conf/ 底下，
#  由 fleet 設定產生。
#
#      conf/global.caddy     全域選項（ACME、DNS…）
#      conf/sites/*.caddy    一個站一個檔
#      apps/*.caddy          手寫／AI 寫的 app 路由（由 conf/sites 裡的 node 站 import）
#
#  import 的相對路徑是以「這個檔案的位置」為基準，不是工作目錄，
#  所以整包目錄搬到哪裡都能跑。
#
#  重載設定：caddy reload --config <這個檔> --adapter caddyfile
#            或呼叫 action：POST /_/run/caddy-reload
# =============================================================================
{
	import conf/global.caddy
}

# -----------------------------------------------------------------------------
#  sitelog <log 檔完整路徑>
#
#  一定要把「整條路徑」當參數傳。不要在 snippet 裡用 {args[0]} 去組字串 ——
#  Caddyfile 的 snippet 參數只在整個 token 的位置代換，不會進到引號字串裡面，
#  結果會原樣留著 {args[0]}，然後在 provision 階段炸成
#  "unrecognized placeholder"。（實測過。）
# -----------------------------------------------------------------------------
(sitelog) {
	log {
		output file {args[0]} {
			roll_size 20MiB
			roll_keep 5
		}
		format console
	}
}

# -----------------------------------------------------------------------------
#  winpath
#
#  Windows 上同一個檔案有好幾個名字，而路徑規則（basic_auth /x/*、
#  @private path /.git/*）比對的是網址字串，認不得這些別名。不擋的話，下面這些網址
#  都會繞過規則開到真正的檔案，經過 WebDAV 還寫得進去：
#
#      /x./a.html                  資料夾名結尾的點，開檔時會被去掉（%2E、%5C 也算）
#      /LONG-N~1/long-name.html    8.3 短檔名
#      /x::$INDEX_ALLOCATION/a     NTFS 資料流
#
#  所以凡是把網址對應到磁碟的 snippet，第一件事就是 import 這個。這些名字在 Windows
#  上不可能是真的檔名，回 404 不會誤傷；別的系統上它們是合法的檔名，所以要看
#  {system.os}。
#
#  三個要注意的：
#
#  1. Caddy 內建的檢查不夠。file_server 只有在最後一段不超過 12 個字元時才擋短檔名，
#     webdav 則什麼都不擋。
#
#  2. 不要搬到站台那一層。reverse_proxy 的 app 不碰磁碟，/myapp/wiki/Apple_Inc.
#     對它是正當的網址。
#
#  3. 要用 handle，不能用 respond。respond 的順序比 handle 晚，會排到 .md 渲染
#     後面；沒有路徑的 handle 則照書寫順序比對，所以 import 寫在最前面就是最先比對，
#     不管外面是 route 還是站台第一層。
# -----------------------------------------------------------------------------
(winpath) {
	# 依序是：名字結尾的點或空白、冒號（NTFS 資料流）、8.3 短檔名
	@winpath {
		expression `{system.os} == "windows"`
		path_regexp `[. ]([/\\]|$)|:|[/\\][^/\\.]{1,6}~[0-9]{1,6}(\.[^/\\.]{1,3})?([/\\]|$)`
	}
	handle @winpath {
		respond 404
	}
}

# -----------------------------------------------------------------------------
#  fsdav <實體路徑> <URL 前綴> <樣板所在目錄>
#
#  一個目錄 = 可瀏覽的靜態站 + Markdown 渲染 + 可讀寫的 WebDAV，同一個網址。
#  前綴傳 "" 就是掛在站台根目錄。樣板目錄裡要有 md.html 和 browse.html
#  （目錄列表，少了它列表會整頁失敗）。
#
#  三個關鍵，改之前先看：
#
#  1. 用 route 而不是靠 Caddy 的預設 directive 排序。預設排序會把
#     uri strip_prefix 排在 webdav 前面，於是 webdav 的 prefix 找不到前綴可剝，
#     整組回 404。route 裡面是照書寫順序執行的。
#
#  2. 前綴一定要交給 webdav 自己的 prefix，不能用 handle_path 事先剝掉。
#     handle_path 只改 r.URL.Path，不會動 MOVE/COPY 的 Destination header，
#     結果在 WebDAV 客戶端裡「重新命名檔案」會 403。
#
#  3. .md 只在瀏覽器來要（Accept: text/html）時才渲染。否則 WebDAV 客戶端
#     GET 一個 .md 會拿到 HTML，一存檔就把原稿蓋掉。?raw=1 可強制拿原始檔。
# -----------------------------------------------------------------------------
(fsdav) {
	route {
		import winpath

		# 非 GET/HEAD 的方法交給 WebDAV
		@dav method PROPFIND PROPPATCH MKCOL COPY MOVE LOCK UNLOCK OPTIONS PUT DELETE
		webdav @dav {
			root {args[0]}
			prefix {args[1]}
		}

		# 以下是 GET/HEAD：改由 file_server 處理，這時才把前綴剝掉
		uri strip_prefix {args[1]}
		root * {args[0]}

		@mdview {
			method GET HEAD
			path *.md *.markdown
			not query raw=*
			header Accept *text/html*
		}
		handle @mdview {
			rewrite * /md.html
			root * {args[2]}
			templates
			file_server
		}

		file_server {
			browse {args[2]}/browse.html
		}
	}
}

# -----------------------------------------------------------------------------
#  cfgfile <檔案所在目錄> <目錄裡的真實檔名>
#
#  把家目錄裡某一個設定檔掛到一個網址上，順便改名 —— OpenClaw、Claude Code、
#  Codex 的設定檔擺在一起會有三個 settings.json，分不出誰是誰。
#
#  兩個要注意的：
#
#  1. rewrite 一定要排在 webdav 前面。webdav 是拿「請求路徑」去 root 底下找檔案，
#     所以要先把 /c/claude.json 改寫成 /settings.json，它才找得到。route 裡面是
#     照書寫順序執行的，不是靠 directive 排序。
#
#  2. **安全性靠的是呼叫端的 handle 路徑，不是這個 snippet。** 這裡的 root 是
#     整個目錄，是呼叫端寫 `handle /c/claude.json`（確切路徑，不是 /c/*）
#     才讓同目錄的鄰居打不到 —— .claude 底下還有 .credentials.json。
#     改成萬用字元就等於把整個目錄開出去。
# -----------------------------------------------------------------------------
(cfgfile) {
	route {
		rewrite * {args[1]}
		@dav method PROPFIND PROPPATCH COPY MOVE LOCK UNLOCK OPTIONS PUT DELETE
		webdav @dav {
			root {args[0]}
		}
		root * {args[0]}
		file_server
	}
}

# -----------------------------------------------------------------------------
#  webroot <實體路徑> <樣板所在目錄>
#
#  唯讀的公開網站：目錄列表、少尾斜線自動導正、.md 渲染成 HTML。
#  沒有 WebDAV —— 要寫入是 fsdav 的事，而那掛在 /_/ 底下（有密碼）。
#  樣板目錄跟 fsdav 一樣，要有 md.html 和 browse.html。
#
#  第二個參數不能省。原本這個 snippet 只有一個參數，樣板寫死成「內容目錄底下的
#  md.html」，而產生器從來沒有把樣板放進內容目錄過（它產生的是 conf\md.html）。
#  結果 edge 自己服務的靜態站，**任何 .md 一律 404** —— 連 ?raw=1 都拿不到，
#  因為 rewrite 在比對 Accept 之前就發生了。實測踩到的，從第一版就壞著。
# -----------------------------------------------------------------------------
(webroot) {
	import winpath

	root * {args[0]}
	@check_slash {
		not path */
		file {path}/
	}
	# 包在 handle 裡才會排在 winpath 後面。redir 本身的順序比 handle 早，直接寫的話，
	# /x. 會先被導正成 /x./ 才回 404。
	handle @check_slash {
		redir {path}/ 308
	}

	# .md 只在瀏覽器來要（Accept: text/html）時才渲染，跟 fsdav 一致。
	# 否則 curl / 下載工具拿到的會是 HTML 而不是原稿。?raw=1 可強制拿原始檔。
	@mdview {
		method GET HEAD
		path *.md *.markdown
		not query raw=*
		header Accept *text/html*
	}
	handle @mdview {
		rewrite * /md.html
		root * {args[1]}
		templates
		file_server
	}

	file_server {
		browse {args[1]}/browse.html
	}
}

# =============================================================================
import conf/sites/*.caddy
